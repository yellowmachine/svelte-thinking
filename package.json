{
	"name": "svelte-thinking",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"genpwd": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project server",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:full": "bun run db:test:ready && playwright test",
		"db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
		"db:test:down": "docker compose -f docker-compose.test.yml down",
		"db:test:migrate": "MIGRATION_DATABASE_URL=postgres://scholarly:scholarly_test@localhost:5434/scholio_test bun scripts/migrate.ts",
		"db:test:ready": "bun run db:test:up && bun run db:test:migrate",
		"pwa:icons": "pwa-assets-generator",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"prettier --check",
			"eslint --max-warnings=0"
		],
		"*.{json,yml,yaml,md,css}": [
			"prettier --check"
		]
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@chromatic-com/storybook": "^5.0.1",
		"@electric-sql/pglite": "^0.4.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.2",
		"@storybook/addon-a11y": "^10.3.0",
		"@storybook/addon-docs": "^10.3.0",
		"@storybook/addon-svelte-csf": "^5.0.12",
		"@storybook/addon-vitest": "^10.3.0",
		"@storybook/sveltekit": "^10.3.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/diff": "^8.0.0",
		"@types/dompurify": "^3.2.0",
		"@types/katex": "^0.16.8",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.0",
		"@types/qrcode": "^1.5.6",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.0",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.0",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"mdsvex": "^0.12.6",
		"otpauth": "^9.5.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.3.0",
		"svelte": "^5.51.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.80.0",
		"@aws-sdk/client-s3": "^3.1012.0",
		"@aws-sdk/s3-request-presigner": "^3.1012.0",
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.2",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/lint": "^6.9.5",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@mozilla/readability": "^0.6.0",
		"@retorquere/bibtex-parser": "^9.0.29",
		"@sentry/sveltekit": "^10.45.0",
		"@trpc/client": "^11.13.0",
		"@trpc/server": "^11.13.0",
		"@types/turndown": "^5.0.6",
		"better-auth": "~1.4.21",
		"codemirror": "^6.0.2",
		"dexie": "^4.4.1",
		"diff": "^8.0.3",
		"dompurify": "^3.3.3",
		"drizzle-orm": "^0.45.1",
		"fflate": "^0.8.2",
		"ioredis": "^5.10.1",
		"katex": "^0.16.39",
		"linkedom": "^0.18.12",
		"marked": "^17.0.4",
		"marked-footnote": "^1.4.0",
		"mermaid": "^11.14.0",
		"nodemailer": "^8.0.5",
		"postgres": "^3.4.8",
		"qrcode": "^1.5.4",
		"superjson": "^2.2.6",
		"turndown": "^7.2.4",
		"vega-embed": "^7.1.0",
		"vega-lite": "^6.4.2",
		"yaml": "^2.8.2",
		"zod": "^4.3.6"
	}
}

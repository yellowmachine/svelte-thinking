# ── PostgreSQL (dev docker) ────────────────────────────────────────────────────
POSTGRES_PORT=5433
POSTGRES_USER=scholio
POSTGRES_PASSWORD=scholio_dev
POSTGRES_DB=scholio

# Rol con el que se conecta la app (RLS). `bun run db:migrate` lo crea si no existe.
APP_DB_USER=scholio_app
APP_DB_PASSWORD=scholio_app_dev

# ── Drizzle ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://scholio_app:scholio_app_dev@localhost:5433/scholio"
MIGRATION_DATABASE_URL="postgres://scholio:scholio_dev@localhost:5433/scholio"

# ── App ───────────────────────────────────────────────────────────────────────
ORIGIN="http://localhost:5174"
# Email y contraseña del administrador — los siembra scripts/migrate.mjs
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# «Entrar con Seilide» (opcional). Sin las tres, no sale el botón.
# El administrador de Seilide crea el cliente en <SEILIDE_URL>/admin/apps (sin
# «para familias»), con la vuelta <ORIGIN>/api/auth/oauth2/callback/seilide.
SEILIDE_URL="https://nube.scholio.review"
SEILIDE_CLIENT_ID=""
SEILIDE_CLIENT_SECRET=""

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# ProtonMail SMTP (sin Bridge): smtp.protonmail.com puerto 465 SSL
# Contraseña = token SMTP generado en Configuración → Tokens SMTP de Proton
SMTP_HOST="smtp.protonmail.ch"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@scholio.review"
SMTP_PASS=""
EMAIL_FROM="Scholio <no-reply@scholio.review>"

# ── Email (Resend) — kept for reference, not active ──────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="Scholio <noreply@support.scholio.review>"

# ── URLs que da el usuario (importar por URL, Jupyter, endpoint S3) ───────────
# Por defecto el servidor se niega a pedir direcciones de red privada (db,
# redis, el host…). En `bun run dev` se permiten. Ponlo a true solo si alojas
# Scholio con Jupyter o S3 en tu misma red privada.
# ALLOW_PRIVATE_URLS="true"

# ── Storage ───────────────────────────────────────────────────────────────────
# Ninguna variable: cada usuario u organización configura su S3 en Settings →
# Storage. En local, el rustfs de docker-compose.dev.yml sirve (ver allí).

# ── OpenAI (embeddings — text-embedding-3-small, 1536 dims) ──────────────────
OPENAI_API_KEY=""

# ── Asistente IA ──────────────────────────────────────────────────────────────
# Sin variable: cada usuario u organización conecta su clave de OpenRouter
# (BYOK) en Settings → AI. Las claves se cifran con KMS_MASTER_KEY.

# ── Typst (genera los PDF) ────────────────────────────────────────────────────
# En dev: el servicio typst de docker-compose.dev.yml  |  En prod: http://typst:3100
TYPST_SERVICE_URL="http://localhost:3100"

# ── Kroki (renderiza los diagramas Mermaid embebidos a SVG para el export a PDF) ──
# En dev: http://localhost:8005  |  En prod (docker): http://kroki:8000
KROKI_URL="http://localhost:8005"

# ── Cifrado de API keys y credenciales S3 de usuario (AES-256-GCM local) ──────
# Obligatoria para guardar claves BYOK. Cualquier cadena larga: bun run genpwd.
# Cambiarla deja ilegibles las claves ya guardadas.
KMS_MASTER_KEY=""

# ── ORCID (opcional: vincular el ORCID iD del perfil) ─────────────────────────
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_REDIRECT_URI="http://localhost:5173/api/orcid/callback"
# https://orcid.org en producción
ORCID_BASE_URL="https://sandbox.orcid.org"

# ── Slack (notificaciones internas) ──────────────────────────────────────────
# Incoming Webhook: Slack → Settings → Apps → Incoming Webhooks → Add New
SLACK_WEBHOOK_URL=""

# ── Sentry ────────────────────────────────────────────────────────────────────
# Server-side DSN (privado, no en cliente)
SENTRY_DSN=""
# Public DSN (se expone al navegador para errores de cliente)
PUBLIC_SENTRY_DSN=""

# Redis
REDIS_URL="redis://localhost:6379"

# ── Bun HTTP server ───────────────────────────────────────────────────────────
# Default is 512K which is too small for EPUB uploads (app allows up to 100 MB).
BODY_SIZE_LIMIT=100M

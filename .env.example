# ── PostgreSQL (dev docker) ────────────────────────────────────────────────────
POSTGRES_PORT=5433
POSTGRES_USER=scholio
POSTGRES_PASSWORD=scholio_dev
POSTGRES_DB=scholio

APP_DB_USER=scholio_app
APP_DB_PASSWORD=scholio_app_dev

# ── Drizzle ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://scholio_app:scholio_app_dev@localhost:5433/scholio"
MIGRATION_DATABASE_URL="postgres://scholio:scholio_dev@localhost:5433/scholio"

# ── App ───────────────────────────────────────────────────────────────────────
ORIGIN="http://localhost:5174"
PUBLIC_LIBRARIAN_URL="https://librarian.scholio.review"
# Email y contraseña del administrador — seeded en migrate.ts
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# GitHub OAuth (opcional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Scholio <noreply@support.scholio.review>"

# ── Storage (MinIO / S3-compatible) ───────────────────────────────────────────
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="scholio"
# URL pública desde la que el navegador descarga las fotos
# En prod: https://storage.scholio.tech
STORAGE_PUBLIC_URL="http://localhost:9000"

# MinIO root credentials (solo para docker-compose)
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""

# ── Embed service (búsqueda semántica) ────────────────────────────────────────
# En dev: http://localhost:3200  |  En prod (docker): http://embed:3200
EMBED_SERVICE_URL="http://localhost:3200"

# ── Scipy service (PDF generation, statistics) ────────────────────────────────
# En dev: http://localhost:3400  |  En prod (docker): http://scipy:3400
SCIPY_SERVICE_URL="http://localhost:3400"
SCIPY_API_KEY=""

# ── LanguageTool (corrector ortográfico/gramática) ────────────────────────────
# En dev: http://localhost:8010  |  En prod (docker): http://languagetool:8010
LANGUAGETOOL_URL="http://localhost:8010"

# ── AWS KMS (cifrado de API keys de usuario BYOK) ─────────────────────────────
# IAM user con permisos: kms:GenerateDataKey y kms:Decrypt
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# ARN o alias de la Customer Managed Key en KMS
AWS_KMS_KEY_ID=""

# ── Slack (notificaciones internas) ──────────────────────────────────────────
# Incoming Webhook: Slack → Settings → Apps → Incoming Webhooks → Add New
SLACK_WEBHOOK_URL=""

# ── Sentry ────────────────────────────────────────────────────────────────────
# Server-side DSN (privado, no en cliente)
SENTRY_DSN=""
# Public DSN (se expone al navegador para errores de cliente)
PUBLIC_SENTRY_DSN=""

# ── Backup PostgreSQL → Cloudflare R2 (solo producción) ──────────────────────
# Crear bucket en Cloudflare R2 dashboard
# R2_ENDPOINT tiene el formato: https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET="scholio-backups"
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
BACKUP_RETENTION_DAYS="30"

# Redis
REDIS_URL="redis://localhost:6379"
